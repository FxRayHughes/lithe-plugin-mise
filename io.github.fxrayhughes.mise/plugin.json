{
  "schemaVersion": 2,
  "id": "io.github.fxrayhughes.mise",
  "displayName": "mise",
  "version": "0.2.0",
  "pluginAPIVersion": 3,
  "requires": {
    "toolchainProviders": 1,
    "backend": 2,
    "serverProcess": 1,
    "settings": 2
  },
  "vendor": {
    "id": "io.github.fxrayhughes",
    "displayName": "FxRayHughes",
    "signatureRequirement": "none"
  },
  "permissions": [
    "backend.launch",
    "toolchains.provide"
  ],
  "settings": [
    {
      "id": "misePath",
      "type": "file",
      "title": "mise 路径",
      "description": "留空时依次查找 ~/.local/bin/mise、Homebrew 和 PATH。填写后只使用这个路径。",
      "default": "",
      "placeholder": "自动查找 mise",
      "section": "mise"
    },
    {
      "id": "offline",
      "type": "boolean",
      "title": "离线查询",
      "description": "查询时设置 MISE_OFFLINE=1，mise 不联网。",
      "default": true,
      "section": "mise"
    }
  ],
  "toolchainProviders": [
    {
      "id": "mise",
      "displayName": "mise",
      "tools": [
        "go",
        "gradle",
        "io.github.lithe-idea.maven-build:maven",
        "java",
        "maven",
        "node",
        "pnpm",
        "python"
      ],
      "watchFiles": [
        {
          "pattern": "mise.toml",
          "reader": "native"
        },
        {
          "pattern": "mise.local.toml",
          "reader": "native"
        },
        {
          "pattern": "mise.*.toml",
          "reader": "native"
        },
        {
          "pattern": ".mise.toml",
          "reader": "native"
        },
        {
          "pattern": ".mise.local.toml",
          "reader": "native"
        },
        {
          "pattern": ".mise.*.toml",
          "reader": "native"
        },
        {
          "pattern": "mise/config.toml",
          "reader": "native"
        },
        {
          "pattern": "mise/config.local.toml",
          "reader": "native"
        },
        {
          "pattern": "mise/conf.d/*.toml",
          "reader": "native"
        },
        {
          "pattern": ".mise/config.toml",
          "reader": "native"
        },
        {
          "pattern": ".mise/config.local.toml",
          "reader": "native"
        },
        {
          "pattern": ".mise/conf.d/*.toml",
          "reader": "native"
        },
        {
          "pattern": ".config/mise.toml",
          "reader": "native"
        },
        {
          "pattern": ".config/mise.local.toml",
          "reader": "native"
        },
        {
          "pattern": ".config/mise/config.toml",
          "reader": "native"
        },
        {
          "pattern": ".config/mise/config.local.toml",
          "reader": "native"
        },
        {
          "pattern": ".config/mise/mise.toml",
          "reader": "native"
        },
        {
          "pattern": ".config/mise/conf.d/*.toml",
          "reader": "native"
        },
        {
          "pattern": ".tool-versions",
          "reader": "compatible"
        },
        {
          "pattern": ".java-version",
          "reader": "compatible"
        },
        {
          "pattern": ".node-version",
          "reader": "compatible"
        },
        {
          "pattern": ".nvmrc",
          "reader": "compatible"
        },
        {
          "pattern": ".python-version",
          "reader": "compatible"
        },
        {
          "pattern": ".sdkmanrc",
          "reader": "compatible"
        }
      ]
    }
  ],
  "backend": {
    "launch": {
      "kind": "packaged",
      "path": "bin/mise-provider"
    },
    "arguments": [
      "--stdio",
      "--mise=${setting:misePath}",
      "--offline=${setting:offline}"
    ]
  }
}
